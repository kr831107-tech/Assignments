<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Accessible Webpage</title>

    <style>
        body {
            font-family: Arial;
        }

        .skip-link {
            position: absolute;
            top: -40px;
            left: 10px;
            background: yellow;
            padding: 10px;
        }

        .skip-link:focus {
            top: 10px;
        }
    </style>
</head>
<body>

    <a href="#main-content" class="skip-link">
        Skip to Main Content
    </a>

    <header>
        <h1>Accessible Website</h1>
    </header>

    <nav aria-label="Main Navigation">
        <a href="#home">Home</a> |
        <a href="#about">About</a> |
        <a href="#contact">Contact</a>
    </nav>

    <main id="main-content">

        <section id="home">
            <h2>Home</h2>

            <img src="https://placehold.co/300x150"
                 alt="A sample image representing a website">

            <p>Welcome to our accessible website.</p>
        </section>

        <section id="about">
            <h2>About Us</h2>
            <p>This website follows basic accessibility practices.</p>
        </section>

        <section id="contact">
            <h2>Contact Us</h2>

            <form aria-label="Contact Form">
                <label for="name">Your Name:</label>

                <input type="text"
                       id="name"
                       name="name">

                <button type="submit">Submit</button>
            </form>
        </section>

    </main>

    <footer>
        <p>Copyright &copy; 2026</p>
    </footer>

</body>
</html>